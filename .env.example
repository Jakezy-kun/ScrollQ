# Supabase (accounts + cloud history). Copy this file to .env.local and fill in your values.
# Find them in Supabase: Project Settings -> API.
# Only the public "anon" key belongs here. NEVER put the service-role key in the frontend.
# Leave both empty to run ScrollQ in guest-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: show "Continue with Google". Turn on the Google provider in Supabase first.
VITE_ENABLE_GOOGLE=false

# Optional: background videos for curated posts, from the free Pixabay API.
# Get a key at https://pixabay.com/api/docs/ (log in; it's shown under "key (required)").
# No VITE_ prefix on purpose: only the server function reads it, it never ships in the app.
# On Vercel, add it under Settings -> Environment Variables. Leave empty to keep gradients.
PIXABAY_API_KEY=
